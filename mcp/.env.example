# RLS-bound application role — all tool queries run through this
RELOS_DB_URL_APP=postgresql://relos_app:app@127.0.0.1:55432/relos
# Bootstrap role — resolves tenant slug -> id + terminology at startup only
RELOS_DB_URL_AUTH=postgresql://relos_auth:auth@127.0.0.1:55432/relos
# Which tenant this server instance serves
RELOS_TENANT_SLUG=aurum
